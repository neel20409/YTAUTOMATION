{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Polls the shared Postgres Run queue and executes the paid generation pipeline (script -> TTS -> image -> video -> stitch -> upload) for the YT Automation multi-tenant service.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.4.5",
    "googleapis": "^173.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.16.2",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "@types/wav": "^1.0.4",
    "prisma": "^7.9.1",
    "typescript": "^5.5.4"
  }
}
