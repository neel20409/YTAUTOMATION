# --- Database (Neon Postgres - same instance web/ migrates, shared between both services) ---
# Get this from Vercel's Storage tab (Neon integration) or directly from neon.tech. Neon requires
# sslmode=require unlike a plain local Postgres.
DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/yt_automation?sslmode=require"

# --- Paid Google GenAI (script, TTS, Veo, Imagen all use this one key) ---
GEMINI_API_KEY=""
# Optional overrides - defaults shown:
# GEMINI_MODEL="gemini-3-pro-preview"
# GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
# GEMINI_IMAGE_MODEL="imagen-4.0-generate-001"

# --- YouTube upload (same OAuth client web/'s connect flow issues refresh tokens against) ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Refresh token decryption - MUST match web/.env's TOKEN_ENCRYPTION_KEY exactly ---
TOKEN_ENCRYPTION_KEY=""

# --- Polling ---
# POLL_INTERVAL_MS=5000

# --- Usage cap ---
# Set to "true" for single-operator use (no Stripe billing turned on for real users yet) - runs
# get claimed without checking for an active/under-quota Subscription. Leave unset/false once
# other people are actually using this, so the Stripe-driven cap in poller.ts applies to them.
# SKIP_USAGE_CAP=true
