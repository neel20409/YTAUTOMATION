# Gemini API key (from Google AI Studio) - used for script gen + topic research.
# Free tier (gemini-3-flash-preview) - no billing required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Local Piper TTS (free, offline voiceover). Uncomment and set these if `piper` isn't on
# your PATH, or if voice models live somewhere other than a "voices/" folder next to this
# project. See README "Free-tier setup".
# PIPER_PATH=C:\path\to\piper\piper.exe
# PIPER_VOICES_DIR=voices

# YouTube Data API v3 (OAuth client, from Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:53682/callback

# Each channel is a separate brand account under the same Google login, so each needs
# its own refresh token. Generate each one with:
#   CHANNEL=bharatkaal npm run get-youtube-token
#   CHANNEL=heritage_unfolded npm run get-youtube-token
#   CHANNEL=bloop_and_boo npm run get-youtube-token
# then store each as its own GitHub Actions secret too.
YOUTUBE_REFRESH_TOKEN_BHARATKAAL=
YOUTUBE_REFRESH_TOKEN_HERITAGE_UNFOLDED=
YOUTUBE_REFRESH_TOKEN_BLOOP_AND_BOO=

# Which channel to run this cycle for: bharatkaal | heritage_unfolded | bloop_and_boo
CHANNEL=bharatkaal

# Hugging Face Token (Optional, for ZeroGPU I2V & backup image generation)
HF_TOKEN=

# fal.ai API Key(s) (Optional, Tier 0 for ByteDance Seedance 2.0 / Kling / Veo2 video generation)
# Signup at fal.ai to generate key. Supports multiple keys (FAL_KEY=key1,key2 or FAL_KEY_1, FAL_KEY_2) for auto key-shifting.
FAL_KEY=
# FAL_KEY_1=
# FAL_KEY_2=

# xAI Grok API Key(s) (Tier 0A for Grok Imagine Video 1.5 generation)
# Supports comma-separated list or indexed keys (GROK_KEY_1, GROK_KEY_2) for safety & key-rotation fallback.
GROK_API_KEY=
# GROK_KEY_1=
# GROK_KEY_2=

# Manus AI API Key(s) (Tier 0B for Manus AI Task Video generation)
# Supports comma-separated list or indexed keys (MANUS_KEY_1, MANUS_KEY_2) for safety & key-rotation fallback.
MANUS_API_KEY=
# MANUS_KEY_1=
# MANUS_KEY_2=

