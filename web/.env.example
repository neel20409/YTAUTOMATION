# --- Database ---
# Local dev: any Postgres (e.g. `npx prisma dev`). Production: Neon (via Vercel's Storage tab
# integration, or neon.tech directly) - worker/ connects to this exact same connection string.
# Use Neon's DIRECT (non-pooled, no "-pooler" in the hostname) connection string, not the pooled
# one - Prisma 7 removed the old directUrl split (schema.prisma can no longer point migrations
# and the app runtime at two different URLs), so `prisma migrate deploy` needs this same
# DATABASE_URL to be a direct connection. Not a concern at this scale; matters more once
# concurrent traffic is high enough to need connection pooling.
DATABASE_URL="postgresql://user:password@localhost:5432/yt_automation?schema=public"

# --- Auth.js (app login) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Per-channel YouTube OAuth (youtube.upload scope) ---
# From a Google Cloud Console OAuth client - see video-pipeline/src/getYoutubeToken.ts for the
# equivalent single-operator flow this replaces.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# Must be registered exactly in the Google Cloud Console OAuth client's redirect URIs.
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"

# --- Refresh token encryption (AES-256-GCM) ---
# 32 random bytes, hex-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# --- Paid generation APIs (worker uses these too, listed here for local full-stack dev) ---
GEMINI_API_KEY=""

# --- Stripe ---
# Test-mode secret key from the Stripe dashboard (sk_test_...). Required for /api/stripe/*.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` in local dev, or the
# webhook endpoint's signing secret once a real endpoint is registered in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""
# Price id (price_...) for the "pro" plan in src/lib/plans.ts - create the Product/Price in the
# Stripe dashboard (or via API) first, then paste its price id here.
STRIPE_PRICE_ID_PRO=""
